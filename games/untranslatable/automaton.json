{
  "name": "Untranslatable",
  "summary": "A multiplayer word-bluffing game: find the words no other language has a word for.",
  "application": {
    "kind": "web",
    "description": "Find the words no other language has a word for.",
    "pages": [{ "path": "/", "label": "Play" }],
    "build": {
      "timeoutSeconds": 900
    },
    "runtime": {
      "image": "node:22-bookworm-slim",
      "command": {
        "executable": "node",
        "arguments": ["server.js"],
        "workingDirectory": "."
      },
      "port": 8080
    },
    "health": {
      "path": "/health",
      "startupTimeoutSeconds": 60
    },
    "storage": {
      "dataDirectory": "data",
      "mounts": []
    },
    "isStaticSite": false
  }
}